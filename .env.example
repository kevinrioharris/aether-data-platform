# Source "shop" database (CDC source)
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=shop
SHOP_DB_HOST=localhost
SHOP_DB_PORT=5433

# Kafka (host access; containers override to kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONNECT_URL=http://localhost:8083
CDC_TOPIC_PATTERN=^shop\.public\..*
CDC_CONSUMER_GROUP=bronze-cdc-consumer
CDC_BATCH_MAX_MESSAGES=5000
CDC_BATCH_MAX_SECONDS=30

# Object storage: RustFS, S3-compatible (host access; containers override to http://object-storage:9000)
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
LAKEHOUSE_BRONZE_URI=s3://bronze
LAKEHOUSE_SILVER_URI=s3://silver
LAKEHOUSE_GOLD_URI=s3://gold
LAKEHOUSE_LANDING_URI=s3://landing
